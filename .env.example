# AERION Environment Variables Template
# Copy this file to .env and supply your local configuration and API keys.
# DO NOT commit real secrets to source control.

# ============================================================
# APPLICATION & RUNTIME
# ============================================================
APP_NAME="AERION Platform"
ENVIRONMENT=development
DEBUG=false
HOST=127.0.0.1
PORT=8000
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
REQUEST_ID_HEADER=X-Request-ID
MAX_REQUEST_ID_LENGTH=64
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
INFERENCE_TIMEOUT_SECONDS=60.0
DEVICE=0
LAZY_LOAD_MODELS=true

# ============================================================
# SECURITY & AUTHENTICATION (Phase 3 Foundation)
# ============================================================
JWT_SECRET_KEY=your_jwt_secret_key_change_in_production_min32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ============================================================
# PERSISTENCE (PostgreSQL 16 + PostGIS)
# ============================================================
DATABASE_URL=postgresql+asyncpg://aerion_user:change_me_password@localhost:5432/aerion_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aerion_db
POSTGRES_USER=aerion_user
POSTGRES_PASSWORD=change_me_password
POSTGRES_SSL_MODE=prefer
DATABASE_POOL_SIZE=20

# ============================================================
# OBJECT STORAGE (AWS S3 / MinIO)
# ============================================================
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=D:\mp-1\storage
S3_ENDPOINT_URL=
S3_BUCKET_NAME=aerion-data
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# ============================================================
# AI ADVISORY (Mistral AI)
# ============================================================
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=open-mistral-nemo
MISTRAL_TIMEOUT=60
ENABLE_ADVISORY_REPORTS=true

# ============================================================
# EXTERNAL PROVIDERS (Phase 2.3 Operational Intelligence)
# ============================================================
# Mapbox vector tiles & base maps (Phase 4 Dashboard)
MAPBOX_ACCESS_TOKEN=your_mapbox_public_or_secret_token_here

# OpenRouteService road network routing engine (Phase 3F)
OPENROUTESERVICE_API_KEY=your_openrouteservice_api_key_here

# Weather & Meteorological Provider (Open-Meteo / NOAA)
# Open-Meteo free tier requires no API key for standard usage
WEATHER_API_KEY=
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1
ELEVATION_API_BASE_URL=https://api.open-elevation.com/api/v1

# ============================================================
# SUBSCRIPTION & ENTITLEMENTS (Phase 3H)
# ============================================================
PLAN_FREE_NAME=FREE
PLAN_PRO_NAME=PRO
PLAN_PRO_PRICE_INR=9
