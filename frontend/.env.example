# AERION Frontend Environment Configuration Template
# For local development with Vite proxy, leave VITE_API_BASE_URL unset (defaults to /api/v1).
# For production (e.g. Vercel deployment), set VITE_API_BASE_URL to the target backend API base.
# Example: VITE_API_BASE_URL=https://api.aerion.aviral17.me/api/v1
VITE_API_BASE_URL=

# Google OAuth 2.0 Web Client ID (Public client-side identifier)
# Configured in Google Cloud Console Credentials under Authorized JavaScript Origins
VITE_GOOGLE_CLIENT_ID=491914857043-sqs1p7ntalt2irvr4vju0nav3ol4hnqd.apps.googleusercontent.com
